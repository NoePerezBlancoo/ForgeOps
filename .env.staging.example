APP_ENV=staging
APP_VERSION=1.2.2
BUILD_COMMIT=${{RAILWAY_GIT_COMMIT_SHA}}
DEBUG=false
DOCS_ENABLED=true
MAINTENANCE_MODE=false
LOG_LEVEL=INFO
RUN_MIGRATIONS=false
RUN_RUNTIME_ROLE_SETUP=false
SEED_DEMO_DATA=false
ALLOW_DEMO_SEED=false
DATABASE_URL=replace-with-restricted-pgbouncer-url
MIGRATION_DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_POOL_MODE=pgbouncer
DATABASE_RUNTIME_ROLE=
DATABASE_RUNTIME_LOGIN=forgeops_runtime_login
DATABASE_RUNTIME_PASSWORD=replace-in-railway
DATABASE_USER_IS_RESTRICTED=true
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_STATEMENT_TIMEOUT_MS=30000
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_REQUIRED=true
JOB_QUEUE_NAME=forgeops
JOB_DISPATCH_ENABLED=true
SECRET_KEY=replace-in-railway
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=
API_URL=https://api-staging.forgeops.es
FRONTEND_URL=https://app-staging.forgeops.es
CONTROL_URL=https://control-staging.forgeops.es/control
CORS_ORIGINS=https://app-staging.forgeops.es,https://control-staging.forgeops.es
STORAGE_BACKEND=s3
S3_ENDPOINT=${{Bucket.ENDPOINT}}
S3_ACCESS_KEY=${{Bucket.ACCESS_KEY_ID}}
S3_SECRET_KEY=${{Bucket.SECRET_ACCESS_KEY}}
S3_BUCKET=${{Bucket.BUCKET}}
S3_REGION=${{Bucket.REGION}}
S3_FORCE_PATH_STYLE=false
EMAIL_BACKEND=development
EMAIL_FROM_ADDRESS=no-reply@staging.forgeops.es
EMAIL_FROM_NAME=ForgeOps Staging
SMTP_HOST=replace-in-railway
SMTP_PORT=587
SMTP_USERNAME=replace-in-railway
SMTP_PASSWORD=replace-in-railway
SMTP_USE_TLS=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_API_URL=https://api-staging.forgeops.es/api/v1
NEXT_PUBLIC_SALES_EMAIL=contacto@forgeops.es
NEXT_PUBLIC_DEMO_CREDENTIALS=false
NEXT_PUBLIC_APP_VERSION=1.2.2
NEXT_PUBLIC_BUILD_COMMIT=${{RAILWAY_GIT_COMMIT_SHA}}
NEXT_PUBLIC_ENVIRONMENT=staging
NEXT_PUBLIC_PWA_ENABLED=true

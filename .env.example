APP_ENV=development
APP_VERSION=1.2.1
BUILD_COMMIT=local
DEBUG=false
DOCS_ENABLED=true
MAINTENANCE_MODE=false
LOG_LEVEL=INFO
SEED_DEMO_DATA=true
ALLOW_DEMO_SEED=true
RUN_MIGRATIONS=true
RUN_RUNTIME_ROLE_SETUP=true

POSTGRES_DB=forgeops
POSTGRES_USER=forgeops
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_POOL_MODE=direct
MIGRATION_DATABASE_URL=
DATABASE_RUNTIME_ROLE=forgeops_runtime
DATABASE_USER_IS_RESTRICTED=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_STATEMENT_TIMEOUT_MS=30000
REDIS_REQUIRED=true
JOB_QUEUE_NAME=forgeops
JOB_DISPATCH_ENABLED=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
OPERATOR_ACCESS_TOKEN_MINUTES=10
OPERATOR_REFRESH_TOKEN_HOURS=8
OPERATOR_LOCKOUT_ATTEMPTS=5
OPERATOR_LOCKOUT_MINUTES=15
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

TRIAL_DAYS=30
TRIAL_SIGNUP_ENABLED=true
GLOBAL_FEATURE_FLAGS=

API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CONTROL_URL=http://localhost:3000/control
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SALES_EMAIL=contacto@example.com
NEXT_PUBLIC_DEMO_CREDENTIALS=true
NEXT_PUBLIC_APP_VERSION=1.2.1
NEXT_PUBLIC_BUILD_COMMIT=local
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_PWA_ENABLED=true

STORAGE_BACKEND=local
UPLOAD_DIRECTORY=/app/uploads
MAX_UPLOAD_BYTES=15728640
STORAGE_SIGNED_URL_SECONDS=300
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=eu-west-1
S3_FORCE_PATH_STYLE=true

EMAIL_BACKEND=development
EMAIL_FROM_ADDRESS=no-reply@forgeops.local
EMAIL_FROM_NAME=ForgeOps
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30
RAG_MIN_SEMANTIC_SCORE=0.25
RAG_RELATIVE_SCORE_FLOOR=0.72

OPERATOR_BOOTSTRAP_NAME=ForgeOps Owner
OPERATOR_BOOTSTRAP_EMAIL=owner@example.com
OPERATOR_BOOTSTRAP_PASSWORD=replace-with-a-strong-operator-password

APP_ENV=development
SEED_DEMO_DATA=true
POSTGRES_DB=forgeops
POSTGRES_USER=forgeops
POSTGRES_PASSWORD=replace-with-a-strong-password
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
OPERATOR_ACCESS_TOKEN_MINUTES=10
OPERATOR_REFRESH_TOKEN_HOURS=8
OPERATOR_LOCKOUT_ATTEMPTS=5
OPERATOR_LOCKOUT_MINUTES=15
TRIAL_DAYS=30
TRIAL_SIGNUP_ENABLED=true
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SALES_EMAIL=contacto@example.com
NEXT_PUBLIC_DEMO_CREDENTIALS=true
OPERATOR_BOOTSTRAP_NAME=ForgeOps Owner
OPERATOR_BOOTSTRAP_EMAIL=owner@example.com
OPERATOR_BOOTSTRAP_PASSWORD=replace-with-a-strong-operator-password
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
UPLOAD_DIRECTORY=/app/uploads
MAX_UPLOAD_BYTES=15728640
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30
RAG_MIN_SEMANTIC_SCORE=0.25
RAG_RELATIVE_SCORE_FLOOR=0.72

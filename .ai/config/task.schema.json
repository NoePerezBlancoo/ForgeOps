{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgeOps local AI task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "objective", "allowed_paths", "risk"],
  "properties": {
    "id": { "type": "string", "pattern": "^AI-[0-9]{4,}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "objective": { "type": "string", "minLength": 10, "maxLength": 4000 },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "required_checks": { "type": "array", "items": { "type": "string" } },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
    "timeout_minutes": { "type": "integer", "minimum": 5, "maximum": 480 },
    "allow_commit": { "type": "boolean" },
    "allow_push": { "const": false },
    "allow_merge": { "const": false },
    "allow_network": { "type": "boolean" },
    "risk": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "preferred_model": { "enum": ["auto", "qwen", "devstral"] },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^AI-[0-9]{4,}$" } },
    "context_files": { "type": "array", "items": { "type": "string" } }
  }
}
